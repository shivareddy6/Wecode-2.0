# Copy to .env.local and fill in real values. See docs/SCHEMA.md and
# docs/ARCHITECTURE.md for what each of these backs.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API > service_role in the Supabase dashboard.
# Never expose this to the client. Bypasses RLS entirely — see the
# "Authorization & Data Access Layer" section of ARCHITECTURE.md for
# which specific code paths are allowed to use it and why.
SUPABASE_SERVICE_ROLE_KEY=
