# Copy to .env and fill in real values. See README.md for what each backs.

PORT=4001

# Same Supabase project the Next.js app (apps/web) uses.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API > JWT Keys > "Legacy JWT Secret" in the Supabase
# dashboard. Used to verify incoming session tokens locally (HS256), with
# no round trip to Supabase's Auth server per connection. This project is
# still on the legacy shared-secret signing scheme, not the newer
# asymmetric (JWKS-published) keys — see docs/epics/11-realtime-server.md
# for why. Same trust tier as apps/web's SUPABASE_SERVICE_ROLE_KEY: never
# expose this to a client, treat a leak as "someone can mint a session for
# any user."
SUPABASE_JWT_SECRET=

# Shared secret for the /internal/* HTTP API (broadcast, disconnect) —
# only the Next.js server (apps/web) should ever call these, never a
# browser. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REALTIME_INTERNAL_SECRET=

# Origin(s) allowed to open a socket.io connection (the deployed apps/web
# domain in production, http://localhost:3000 in dev).
ALLOWED_ORIGIN=http://localhost:3000

# Only needed to run `npm run verify` (creates/deletes its own throwaway
# user+room via the admin API) — the same service-role key apps/web uses.
SUPABASE_SERVICE_ROLE_KEY=
