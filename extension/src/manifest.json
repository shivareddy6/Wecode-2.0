{
  "manifest_version": 3,
  "name": "WeCode Connect",
  "version": "0.1.0",
  "description": "Connects your LeetCode account to WeCode so you can compete against friends on real LeetCode problems.",
  "permissions": ["cookies"],
  "host_permissions": ["https://leetcode.com/*", "__API_ORIGIN__/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WeCode Connect"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
